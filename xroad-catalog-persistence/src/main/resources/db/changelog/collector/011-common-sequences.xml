    <changeSet id="011-common-sequences-member-sequence" author="niis">
        <preConditions onFail="MARK_RAN" onFailMessage="member_id_seq sequence exists">
            <not>
                <sequenceExists sequenceName="member_id_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="member_id_seq" startValue="1" incrementBy="1" cacheSize="1"/>
        <sql>ALTER SEQUENCE member_id_seq OWNED BY member.id;</sql>
    </changeSet>
