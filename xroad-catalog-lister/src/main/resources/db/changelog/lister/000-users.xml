<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="000-users-lister-drop" author="niis" dbms="postgresql">
        <preConditions onFail="MARK_RAN" onFailMessage="Failed to remove read-only user because it does not exist">
            <sqlCheck expectedResult="1">
                SELECT count(*) FROM pg_roles WHERE rolname = '${users.lister.username}';
            </sqlCheck>
        </preConditions>
        <sqlFile path="db/changelog/sql/000-drop-user.sql"/>
    </changeSet>
    <changeSet id="000-users-lister-create" author="niis" dbms="postgresql">
        <preConditions onFail="MARK_RAN" onFailMessage="Failed to create read-only user because it already exists">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM pg_roles WHERE rolname = '${users.lister.username}';
            </sqlCheck>
        </preConditions>
        <sqlFile path="db/changelog/sql/000-create-readonly-user.sql"/>
    </changeSet>
</databaseChangeLog>
